# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
#CONFIG_FREERTOS_HZ=1000

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_SOURCE_ENABLED=y
# A2DP source without AVRCP UI/control (runtime may log "A2DP Enable without AVRC"; that is OK).
# CONFIG_BT_AVRCP_ENABLED is selected by A2DP; do not enable AVRCP CT cover art, etc.
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=n

# Default BTC/BTU stacks (3072/4352) overflow during A2DP source init on BTC_TASK.
CONFIG_BT_BTC_TASK_STACK_SIZE=8192
CONFIG_BT_BTU_TASK_STACK_SIZE=5120

# Keep Bluedroid/BT controller off the same core as the UART bridge pthread.
# CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0 is not set
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_1=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE=1
# CONFIG_BTDM_CTRL_PINNED_TO_CORE_0 is not set
CONFIG_BTDM_CTRL_PINNED_TO_CORE_1=y
CONFIG_BTDM_CTRL_PINNED_TO_CORE=1

# UART bridge pthread uses configure_app_pthread(12 KiB); default raised from 3072 for headroom.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384